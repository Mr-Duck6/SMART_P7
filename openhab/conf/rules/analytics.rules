import java.lang.Math
import org.openhab.core.library.types.DecimalType

rule "Detect temperature anomaly Room 1"
when
    Item Temp_Room1 changed
then
    if (previousState !== null && previousState instanceof DecimalType && newState instanceof DecimalType) {
        val Number delta = Math::abs((newState as DecimalType).doubleValue - (previousState as DecimalType).doubleValue)
        if (delta > 5.0) {
            val String message = String::format("%s | Кімната 1 | зміна %.2f °C (було %.2f, стало %.2f)",
                now.toString, delta.doubleValue,
                (previousState as DecimalType).doubleValue, (newState as DecimalType).doubleValue)
            AnomalyStatus.postUpdate("ВИЯВЛЕНО")
            AnomalyLog.postUpdate(message)
            logWarn("PR7-ANOMALY", message)
        }
    }
end

